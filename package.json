{
  "name": "difmp-workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "typecheck": "tsc -b tsconfig.build.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "vitest run",
    "test:ui": "vitest run --config apps/ui/vitest.config.ts",
    "test:packaging": "bash apps/cli/scripts/consumer-smoke/run.sh",
    "test:examples": "bash apps/cli/scripts/ci/run-examples.sh"
  },
  "dependencies": {
    "@effect/ai-anthropic": "4.0.0-rc.113",
    "@effect/platform-node": "4.0.0-rc.113",
    "effect": "4.0.0-rc.113"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.113",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tinyglobby": "~0.2.17",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.29.3"
}
