{
  "name": "difmp-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "typecheck": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:packaging": "bash apps/cli/scripts/consumer-smoke/run.sh",
    "test:examples": "bash apps/cli/scripts/ci/run-examples.sh"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.113",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tinyglobby": "~0.2.17",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.0",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@effect/ai-anthropic": "4.0.0-rc.113",
    "@effect/platform-node": "4.0.0-rc.113",
    "effect": "4.0.0-rc.113"
  }
